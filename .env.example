GEMINI_API_KEY=
DATABASE_URL=
# Free-tier pacing between Gemini calls (ms)
GEMINI_MIN_INTERVAL_MS=4500
# Fund-page scraper: your contact (email or repo URL), sent in the User-Agent so site owners can reach you
SCRAPER_CONTACT=
# Fund website to read thesis + portfolio from (comma-separated if several)
FUND_URL=https://www.allincapital.vc

# ---- Mail and meetings ----
# mock = nothing leaves the app. test = real mail through Resend but ONLY to MAIL_TEST_RECIPIENT. live = to the founders real addresses.
MAIL_MODE=mock
MAIL_TEST_RECIPIENT=
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
# Where replies go (the *.resend.app address from Resend, Receiving Emails, Inbound address)
RESEND_INBOUND_ADDRESS=
RESEND_WEBHOOK_SECRET=
# Only if RESEND_API_KEY is send-only: a key that may read received mail
RESEND_RECEIVING_KEY=
CAL_API_KEY=
CAL_EVENT_TYPE_ID=
DEEPTECH_PARTNER_EMAIL=
# Required once MAIL_MODE is test or live: sending and booking need this passcode (open /unlock)
ACTION_PASSCODE=

# ---- Gmail and Google Calendar (alternative to Resend + Cal.com) ----
# MAIL_PROVIDER=google sends from the connected Gmail, reads replies there, and checks and books the same account's calendar (with a Meet link).
MAIL_PROVIDER=resend
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MAILBOX_EMAIL=
ALLOWED_EMAILS=
# Public address of the site, used for the Google redirect (default: the address the request came to)
APP_URL=
# The invite is signed with this name, then the fund name on the next line
SIGNER_NAME=Riya
# Protects /api/cron/schedule (the "check replies and book" address)
CRON_SECRET=
